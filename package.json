{
  "name": "mathjax-angular",
  "version": "4.0.0",
  "description": "A quick way to implement Mathjax v3 into your Angular project!",
  "homepage": "https://github.com/sajivkumar/mathjax-angular/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/sajivkumar/mathjax-angular.git"
  },
  "bugs": {
    "url": "https://github.com/sajivkumar/mathjax-angular/issues"
  },
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build-lib": "ng build mathjax-lib",
    "build": "run-s -n \"ng build mathjax-lib\" \"ng build testMathjax -- --output-hashing=all  --configuration=production\" --",
    "clean": "rimraf dist",
    "wth:c-lib": "ng build mathjax-lib --watch",
    "srv-app": "wait-on dist/mathjax-lib/public-api.d.ts && run-p -r -n \"ng s -- -c={1} --port 3300 -o\" --",
    "serve": "npm run clean && run-p -r -n \"wth:*\" \"srv-app -- {1}\" --",
    "dev": "npm run serve dev",
    "prod": "npm run serve prod",
    "semantic-release": "semantic-release",
    "commit": "git add . && git-cz",
    "prepare": "npm run build-lib"
  },
  "private": true,
  "dependencies": {
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@types/jest": "^26.0.23",
    "@types/mathjax": "^0.0.37",
    "@types/node": "^18.7.21",
    "cz-conventional-changelog": "^3.3.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^16.0.0",
    "karma-coverage": "~2.0.3",
    "ng-packagr": "^21.2.7",
    "npm-run-all": "^4.1.5",
    "semantic-release": "^23.0.2",
    "typescript": "~5.9.3",
    "wait-on": "^7.2.0",
    "@angular/animations": "^21.2.26",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "rxjs": "~7.5.0",
    "zone.js": "^0.15.0"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "./projects/example/setup-jest.ts",
      "./projects/mathjax-lib/setup-jest.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootdir>/node_modules/",
      "<rootdir>/dist/"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "./tsconfig.spec.json",
        "stringifyContentPathRegex": "\\.html$"
      }
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "pkgRoot": "dist/mathjax-lib",
    "branches": [
      "main"
    ]
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0"
  },
  "files": [
    "dist/mathjax-lib"
  ],
  "module": "./dist/mathjax-lib/fesm2022/mathjax-angular.mjs",
  "typings": "./dist/mathjax-lib/types/mathjax-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mathjax-lib/types/mathjax-angular.d.ts",
      "default": "./dist/mathjax-lib/fesm2022/mathjax-angular.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
